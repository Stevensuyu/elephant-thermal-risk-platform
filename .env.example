# ── 真实大模型研判接入配置 ──────────────────────────────────────────────
# 复制本文件为 .env.local 并填入你的免费 API Key 即可启用"真·AI 研判"。
# 不配置时系统自动回退到规则引擎，功能不受影响。
#
# ✅ 推荐（永久免费、无需信用卡、国内直连）：
#    智谱 AI GLM-4-Flash —— 官方承诺永久免费、无 token 上限、1 并发。
#    注册地址：https://open.bigmodel.cn → 个人中心 → API Keys → 新建
#    密钥形如 xxxxxxxx.xxxxxxxx（中间有点号，复制时别漏）。

# 必填：大模型 API Key（不填 = 规则引擎）
AI_API_KEY=

# 默认即为智谱 GLM-4-Flash（永久免费），一般无需改动
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 默认模型（永久免费的 Flash 系列；如需更强可换 glm-4.7-flash）
AI_MODEL=glm-4-flash

# 可选：是否要求 JSON 输出（默认开启；个别模型不支持时设为 0）
AI_JSON_MODE=1

# ── 备选免费/低价方案（改上面两项即可切换，无需改代码）──────────────────
# DeepSeek（新号送 500 万 token，极便宜，国内直连）：
#   AI_BASE_URL=https://api.deepseek.com/v1
#   AI_MODEL=deepseek-chat
# Kimi 月之暗面（新号送 100 万 token，长上下文）：
#   AI_BASE_URL=https://api.moonshot.cn/v1
#   AI_MODEL=kimi-k2.5
# OpenRouter（统一网关，含大量免费模型，无需信用卡）：
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=deepseek/deepseek-chat:free
# 通义千问 / 阿里云百炼（中文强，有免费额度）：
#   AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   AI_MODEL=qwen-plus
=======
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Vercel production should point to an external GPU/YOLO service endpoint.
YOLO_SERVICE_URL=

# Local or self-hosted Node runtime can run the Python ultralytics script directly.
YOLO_PYTHON=python
YOLO_WEIGHTS=yolov8n.pt

WORKER_API_KEY=local-worker-key
API_URL=http://localhost:3000/api
TRAINING_MODE=real
